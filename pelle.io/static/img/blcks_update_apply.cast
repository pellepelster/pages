[0.002, "o", "\r\n\u001b[38;5;176m─────────────────────────────────── \u001b[1mServers\u001b[22m ───────────────────────────────────\u001b[39m\r\n\r\nto access server \u001b[1mpelle-default-public-0\u001b[22m via SSH, run\r\n╭──────────────────────────────────────────────────────────────╮\r\n│\u001b[38;5;111mssh -F /home/pelle/git/infrastructure/pelle_default_ssh_config\u001b[39m│\r\n│\u001b[38;5;111mpelle-default-public-0                                        \u001b[39m│\r\n╰──────────────────────────────────────────────────────────────╯\r\n\r\n\u001b[38;5;176m────────────────────────────────── \u001b[1mEndpoints\u001b[22m ──────────────────────────────────\u001b[39m\r\n\r\n • GarageFs S3 endpoint: \u001b[38;5;111mhttps://s3.pelle-default-public-0.pelle.io\u001b[39m\r\n • GarageFs admin endpoint: \u001b[38;5;111mhttps://s3-admin.pelle-default-public-0.pelle.io\u001b[39m\r\n\r\n\r\n\u001b[38;5;176m─────────────────────────────────── \u001b[1mSecrets\u001b[22m ───────────────────────────────────\u001b[39m\r\n\r\n\u001b[1mGarageFS admin secret\u001b[22m\r\n╭─────────────────────────────────────────────────────────────────────╮\r\n│\u001b[38;5;111mexport ADMIN_SECRET=\"$(pass pelle/default/public/garage/admin_token)\"\u001b[39m│\r\n╰─────────────────────────────────────────────────────────────────────╯\r\n\u001b[1mGarageFS metrics secret\u001b[22m\r\n╭─────────────────────────────────────────────────────────────────────────╮\r\n│\u001b[38;5;111mexport METRICS_SECRET=\"$(pass pelle/default/public/garage/metrics_token)\"\u001b[39m│\r\n╰─────────────────────────────────────────────────────────────────────────╯\r\n\r\n\u001b[38;5;176m─────────────────────────────── \u001b[1mUsage examples\u001b[22m ────────────────────────────────\u001b[39m\r\n\r\n\u001b[1mBucket 'pelle.io' with access key 'pelle.io'\u001b[22m\r\n╭───────────────────────────────────────────────────────────────╮\r\n│\u001b[38;5;111mexport ACCESS_KEY=\"$(pass                                      \u001b[39m│\r\n│\u001b[38;5;111mpelle/default/public/buckets/pelle.io/admin/access_key)\"       \u001b[39m│\r\n│\u001b[38;5;111mexport SECRET_KEY=\"$(pass                                      \u001b[39m│\r\n│\u001b[38;5;111mpelle/default/public/buckets/pelle.io/admin/secret_key)\"       \u001b[39m│\r\n│\u001b[38;5;111mexport S3_HOST=\"$(pass pelle/default/public/endpoints/s3_host)\"\u001b[39m│\r\n│\u001b[38;5;111m                                                               \u001b[39m│\r\n│\u001b[38;5;111ms3cmd --host-bucket \"%(bucket).${S3_HOST} \\                    \u001b[39m│\r\n│\u001b[38;5;111m    --host ${S3_HOST} \\                                        \u001b[39m│\r\n│\u001b[38;5;111m    --access_key ${ACCESS_KEY} \\                               \u001b[39m│\r\n│\u001b[38;5;111m    --secret_key ${SECRET_KEY} \\                               \u001b[39m│\r\n│\u001b[38;5;111m    ls s3://pelle.io                                           \u001b[39m│\r\n╰───────────────────────────────────────────────────────────────╯\r\n\u001b[1mBucket 'solidblocks.de' with access key 'solidblocks.de'\u001b[22m\r\n╭───────────────────────────────────────────────────────────────╮\r\n│\u001b[38;5;111mexport ACCESS_KEY=\"$(pass                                      \u001b[39m│\r\n│\u001b[38;5;111mpelle/default/public/buckets/solidblocks.de/admin/access_key)\" \u001b[39m│\r\n│\u001b[38;5;111mexport SECRET_KEY=\"$(pass                                      \u001b[39m│\r\n│\u001b[38;5;111mpelle/default/public/buckets/solidblocks.de/admin/secret_key)\" \u001b[39m│\r\n│\u001b[38;5;111mexport S3_HOST=\"$(pass pelle/default/public/endpoints/s3_host)\"\u001b[39m│\r\n│\u001b[38;5;111m                                                               \u001b[39m│\r\n│\u001b[38;5;111ms3cmd --host-bucket \"%(bucket).${S3_HOST} \\                    \u001b[39m│\r\n│\u001b[38;5;111m    --host ${S3_HOST} \\                                        \u001b[39m│\r\n│\u001b[38;5;111m    --access_key ${ACCESS_KEY} \\                               \u001b[39m│\r\n│\u001b[38;5;111m    --secret_key ${SECRET_KEY} \\                               \u001b[39m│\r\n│\u001b[38;5;111m    ls s3://solidblocks.de                                     \u001b[39m│\r\n╰───────────────────────────────────────────────────────────────╯\r\n"]
[0.001, "x", "0"]
